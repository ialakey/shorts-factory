# Copy to .env and fill in. Never commit .env — it is git-ignored.
# Скопируйте в .env и заполните. .env закоммитить нельзя — он в .gitignore.

# Required: config.py raises on import without it.
# Обязателен: без него config.py падает уже на импорте.
OPENAI_API_KEY=sk-...

# Optional: only for the telegram_notify stage.
# Опционально: нужен только этапу telegram_notify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: only for the kodik_download stage. No token is needed — these are
# an AnimeGO mirror and a proxy, for when the default domain is blocked.
# Опционально: только для этапа kodik_download. Токен не нужен — это зеркало
# AnimeGO и прокси на случай, если основной домен заблокирован.
# ANIMEGO_MIRROR=animego.me
# ANIME_DL_PROXY=socks5://127.0.0.1:1080
