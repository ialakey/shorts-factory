# Copy to .env and fill in. Never commit .env — it is git-ignored.
# Скопируйте в .env и заполните. .env закоммитить нельзя — он в .gitignore.

# Required: config.py raises on import without it.
# Обязателен: без него config.py падает уже на импорте.
OPENAI_API_KEY=sk-...

# Optional: only for the telegram_notify stage.
# Опционально: нужен только этапу telegram_notify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: only for the kodik_download stage.
# Опционально: нужен только этапу kodik_download.
KODIK_TOKEN=
